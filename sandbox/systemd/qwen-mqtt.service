[Unit]
Description=Stream Qwen Log to MQTT (Home Assistant)
After=network-online.target
Wants=network-online.target

[Service]
# Passwort NIE hier eintragen (Repo ist öffentlich). Es steht nur in /etc/qwen-mqtt.env
# (MQTT_PASS=…, Rechte 600); install.sh fragt es verdeckt ab, wenn die Datei fehlt.
EnvironmentFile=/etc/qwen-mqtt.env
Environment=MQTT_HOST=192.168.0.148
Environment=MQTT_USER=LLM
Environment=MQTT_TOPIC=sc_digger/worker/log
# $$ = erst bash setzt die Werte ein, nicht systemd (sonst stünde das Passwort in der Befehlszeile der Unit).
ExecStart=/bin/bash -c 'tail -n 0 -F /root/worker.log | mosquitto_pub -h "$$MQTT_HOST" -u "$$MQTT_USER" -P "$$MQTT_PASS" -t "$$MQTT_TOPIC" -l'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
