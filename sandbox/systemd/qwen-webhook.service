[Unit]
Description=Worker-Log per Webhook an Home Assistant (ersetzt qwen-mqtt)
After=network-online.target
Wants=network-online.target

[Service]
# HA_WEBHOOK_URL=http://192.168.0.148:8123/api/webhook/<id> nur in /etc/qwen-webhook.env (600),
# nie im Repo – die ID ist das Geheimnis. install.sh fragt sie verdeckt ab.
EnvironmentFile=/etc/qwen-webhook.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /root/qwen_webhook.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
